{
    "name": "marketplace/auth",
    "description": "Marketplace Auth Service",
    "type": "project",
    "require": {
        "php": "^8.5",
        "lcobucci/jwt": "^5.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Auth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Auth\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
