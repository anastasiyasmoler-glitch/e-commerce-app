HTTP_ADDR=:8080
OPENSEARCH_URL=http://opensearch:9200
KAFKA_BROKERS=kafka:9092
KAFKA_CONSUMER_GROUP=search-service-group
KAFKA_CONSUME_TOPICS=product.created,product.updated,product.deleted,category.created,category.updated,category.deleted,stock.changed
REDIS_ADDR=redis:6379
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
FUZZY_SEARCH=true
FACET_ATTRIBUTE_KEYS=color,material
