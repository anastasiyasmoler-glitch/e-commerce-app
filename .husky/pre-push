#!/bin/sh
# Блокирует push, если линт/форматирование не проходит в каком-либо сервисе
PHP="/c/Users/Nastja/.config/herd/bin/php84/php.exe"
[ -x "$PHP" ] || PHP="/c/Users/Nastja/.config/herd/bin/php.bat"
FAILED=""

for svc in admin frontend; do
  if [ -d "$svc" ]; then
    echo "==> $svc: npm run lint"
    (cd "$svc" && npm run lint) || FAILED="$FAILED $svc"
  fi
done

for svc in auth catalog notification; do
  if [ -d "$svc/vendor/laravel/pint" ]; then
    echo "==> $svc: pint --test"
    (cd "$svc" && "$PHP" vendor/laravel/pint/builds/pint --test) || FAILED="$FAILED $svc"
  fi
done

if [ -n "$FAILED" ]; then
  echo ""
  echo "Push отменён: ошибки линтинга/форматирования в:${FAILED}"
  exit 1
fi
