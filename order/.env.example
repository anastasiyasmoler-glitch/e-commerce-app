APP_NAME=Order
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Direct order nginx TLS (gateway: https://localhost/api/orders).
APP_URL=https://localhost:8445

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=sql
DB_PORT=5432
DB_DATABASE=orders
DB_USERNAME=marketplace
DB_PASSWORD=marketplace

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="orders@example.com"
MAIL_FROM_NAME="${APP_NAME}"

KAFKA_BROKERS=kafka:9092
KAFKA_CONSUMER_GROUP=order-service-group

# Stripe test mode — https://dashboard.stripe.com/test/apikeys
# Without real keys checkout fails (placeholders in docker-compose are not valid).
STRIPE_PUBLISHABLE=pk_test_
STRIPE_SECRET=sk_test_
# Local webhooks: cd order && docker compose --profile stripe up -d stripe-cli
# Copy whsec_… from stripe-cli logs into STRIPE_WEBHOOK_SECRET, restart back.
STRIPE_WEBHOOK_SECRET=whsec_

# Storefront origin (Payment Element return URL is built on the client; keep for other links).
FRONTEND_URL=http://localhost:5173

VITE_APP_NAME="${APP_NAME}"
