APP_NAME=Recommendation
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://localhost:8448

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Docker Compose overrides (back / consumer):
# DB_CONNECTION=pgsql
# DB_HOST=postgres
# DB_PORT=5432
# DB_DATABASE=recommendation
# DB_USERNAME=recommendation
# DB_PASSWORD=recommendation

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

KAFKA_BROKERS=kafka:9092
KAFKA_CONSUMER_GROUP=recommendation-service-group

CATALOG_BASE_URL=https://catalog-nginx

# From Docker use host.docker.internal, not 127.0.0.1 (that is the container itself).
# SOCKS must also accept connections from Docker (not bind 127.0.0.1 only).
HTTPS_PROXY=socks5h://host.docker.internal:1080
HTTP_PROXY=socks5h://host.docker.internal:1080
GEMINI_HTTP_PROXY=socks5h://host.docker.internal:1080

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_SECONDS=25
GEMINI_RETRY_TIMES=2
GEMINI_RETRY_SLEEP_MS=300
RECOMMENDATION_EMBEDDING_DIMENSIONS=1536
RECOMMENDATION_CHAT_RATE_LIMIT_PER_MINUTE=20
RECOMMENDATION_PROMPT_MAX_HISTORY_MESSAGES=10
RECOMMENDATION_PROMPT_MAX_HISTORY_CHARS=4000

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=catalog_products
QDRANT_USE_HTTPS=false

MAIL_MAILER=log
